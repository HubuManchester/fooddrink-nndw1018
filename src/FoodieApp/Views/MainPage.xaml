<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FoodieApp.ViewModels"
             xmlns:models="clr-namespace:FoodieApp.Models"
             xmlns:converters="clr-namespace:FoodieApp.Converters"
             x:Class="FoodieApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="{Binding Title}"
             AutomationProperties.Name="Discover page">

    <ContentPage.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        <converters:RatingToStarsConverter x:Key="RatingToStarsConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <ScrollView AutomationProperties.Name="Discover content">
        <VerticalStackLayout Padding="16" Spacing="24">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                <Label Text="Foodie"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                       AutomationProperties.HeadingLevel="Level1"
                       AutomationProperties.Name="Foodie App Name" />
                <Image Grid.Column="1"
                       Source="icon_settings.png"
                       WidthRequest="44"
                       HeightRequest="44"
                       AutomationProperties.Name="App icon" />
            </Grid>

            <!-- Search Bar -->
            <Border Style="{StaticResource CardStyle}"
                    AutomationProperties.Name="Recipe search">
                <Grid ColumnDefinitions="*,Auto" Padding="4">
                    <Entry Placeholder="Search recipes, ingredients..."
                           Text="{Binding SearchQuery}"
                           ReturnType="Search"
                           ReturnCommand="{Binding SearchCommand}"
                           FontSize="16"
                           AutomationProperties.Name="Search recipes input"
                           AutomationProperties.Hint="Type to search for recipes by name, ingredient, or dietary tag" />
                    <ImageButton Grid.Column="1"
                                 Source="icon_search.png"
                                 WidthRequest="48"
                                 HeightRequest="48"
                                 Command="{Binding SearchCommand}"
                                 AutomationProperties.Name="Search button"
                                 AutomationProperties.Hint="Execute search" />
                </Grid>
            </Border>

            <!-- Error Message -->
            <Border IsVisible="{Binding HasError}"
                    BackgroundColor="{StaticResource ErrorLight}"
                    Style="{StaticResource CardStyle}"
                    AutomationProperties.Name="Error message">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}"
                       FontSize="14" />
            </Border>

            <!-- Activity Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               AutomationProperties.Name="Loading indicator" />

            <!-- Search Results (shown after search) -->
            <VerticalStackLayout IsVisible="{Binding IsSearching}" Spacing="12">
                <Label Text="Search Results"
                       FontSize="20"
                       FontAttributes="Bold"
                       AutomationProperties.HeadingLevel="Level2" />
                <CollectionView ItemsSource="{Binding SearchResults}"
                                SelectionMode="Single"
                                SelectionChangedCommand="{Binding NavigateToRecipeDetailCommand}"
                                SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Recipe">
                            <Border Style="{StaticResource CardStyle}" Margin="0,4">
                                <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="12" Padding="8">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="{StaticResource PrimaryLight}"
                                           CornerRadius="8"
                                           Padding="0"
                                           HasShadow="False">
                                        <Label Text="🍽️"
                                               FontSize="32"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Frame>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding Rating, StringFormat='{0:F1} ★'}"
                                               FontSize="13"
                                               TextColor="{StaticResource Gray500}" />
                                        <Label Text="{Binding Difficulty}"
                                               FontSize="12"
                                               TextColor="{StaticResource Secondary}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding PrepTimeMinutes, StringFormat='{0} min'}"
                                           FontSize="13"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Gray500}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Categories -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}">
                <Label Text="Categories"
                       FontSize="22"
                       FontAttributes="Bold"
                       AutomationProperties.HeadingLevel="Level2" />

                <CollectionView ItemsSource="{Binding Categories}"
                                ItemsLayout="HorizontalList"
                                HeightRequest="110">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:FoodCategory">
                            <Border Style="{StaticResource CardStyle}"
                                    WidthRequest="140"
                                    Margin="0,0,12,0"
                                    Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=NavigateToCategoryCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                                    <Label Text="{Binding Icon}"
                                           FontSize="36"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding RecipeCount, StringFormat='{0} recipes'}"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray500}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Recipe of the Day -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Recipe of the Day"
                           FontSize="22"
                           FontAttributes="Bold"
                           AutomationProperties.HeadingLevel="Level2" />
                    <ImageButton Grid.Column="1"
                                 Source="icon_shuffle.png"
                                 WidthRequest="44"
                                 HeightRequest="44"
                                 Command="{Binding ShakeForRandomRecipeCommand}"
                                 AutomationProperties.Name="Get random recipe"
                                 AutomationProperties.Hint="Shake or tap to get a random recipe suggestion" />
                </Grid>

                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRecipeDetailCommand}"
                                              CommandParameter="{Binding RecipeOfTheDay}" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="120,Auto" ColumnDefinitions="*">
                        <BoxView Grid.Row="0"
                                 Color="{StaticResource PrimaryLight}"
                                 AutomationProperties.IsInAccessibleTree="False" />
                        <Label Grid.Row="0"
                               Text="🍲"
                               FontSize="64"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="8">
                            <Label Text="{Binding RecipeOfTheDay.Name}"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding RecipeOfTheDay.Description}"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray500}"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="{Binding RecipeOfTheDay.Difficulty}"
                                       FontSize="12"
                                       TextColor="{StaticResource Secondary}" />
                                <Label Grid.Column="2"
                                       Text="{Binding RecipeOfTheDay.PrepTimeMinutes, StringFormat='Prep: {0} min'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}" />
                                <Label Grid.Column="3"
                                       Text="{Binding RecipeOfTheDay.Rating, StringFormat='{0:F1} ★'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Popular Recipes -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}">
                <Label Text="Popular Recipes"
                       FontSize="22"
                       FontAttributes="Bold"
                       AutomationProperties.HeadingLevel="Level2" />

                <CollectionView ItemsSource="{Binding PopularRecipes}"
                                SelectionMode="Single"
                                SelectionChangedCommand="{Binding NavigateToRecipeDetailCommand}"
                                SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Recipe">
                            <Border Style="{StaticResource CardStyle}" Margin="0,4">
                                <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="12" Padding="10">
                                    <Frame Grid.Column="0"
                                           CornerRadius="8"
                                           Padding="0"
                                           HasShadow="False"
                                           BackgroundColor="{StaticResource PrimaryLight}">
                                        <Label Text="🥘"
                                               FontSize="28"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Frame>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Rating, StringFormat='{0:F1} ★'}"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Gray500}" />
                                            <Label Text="{Binding Difficulty}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Secondary}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding PrepTimeMinutes, StringFormat='{0}m'}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Primary}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
