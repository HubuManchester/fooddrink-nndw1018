<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- High Contrast Colors for Accessibility -->
    <!-- These meet WCAG 2.1 AA requirements (4.5:1 minimum contrast ratio) -->

    <!-- High Contrast Text on Light Background -->
    <Color x:Key="AccessibleTextLight">#1A1A1A</Color>
    <Color x:Key="AccessibleTextDark">#FAFAFA</Color>

    <!-- High Contrast Primary -->
    <Color x:Key="AccessiblePrimary">#CC5500</Color>

    <!-- High Contrast Error -->
    <Color x:Key="AccessibleError">#D32F2F</Color>

    <!-- High Contrast Success -->
    <Color x:Key="AccessibleSuccess">#2E7D32</Color>

    <!-- Minimum touch target size (44x44pt per WCAG 2.5.5) -->
    <Style x:Key="AccessibleButtonStyle" TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style x:Key="AccessibleImageButtonStyle" TargetType="ImageButton">
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <!-- Screen Reader Compatible Elements -->
    <Style x:Key="ScreenReaderLabel" TargetType="Label">
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="True" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

</ResourceDictionary>
